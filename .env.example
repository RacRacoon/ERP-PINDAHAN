# Salin ke .env lalu isi. Jangan commit .env.

# Neon: dua connection string dari dashboard (Connection Details).
# DATABASE_URL = pooled (host ada "-pooler"), untuk query aplikasi.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL = direct (tanpa "-pooler"), dipakai prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js
AUTH_SECRET="isi dengan: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Login satu user. Hash bcrypt 10 rounds, buat dengan:
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_KAMU',10))"
# Di file .env, tiap $ pada hash HARUS ditulis \$ (escape Next), contoh: \$2b\$10\$abc...
# Di dashboard Vercel (Environment Variables) tulis hash apa adanya, tanpa backslash.
ADMIN_EMAIL="kamu@contoh.com"
ADMIN_NAMA="Rakan"
ADMIN_PASSWORD_HASH=""
